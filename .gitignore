# Any build directory. Not just `build/`: the sanitizer job and the README both
# use `build-asan/`, and a second tree for comparing configurations is routine.
build/
build-*/
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Dear ImGui window layout, written by the frontend into the working directory
imgui.ini

# clangd index
.cache/

# nestest assets, fetched by tests/test_files/fetch_nestest.sh
tests/test_files/nestest.nes
tests/test_files/nestest.log

# agent worktrees
.claude/worktrees/

# SingleStepTests 65x02 vectors, fetched by tests/test_files/fetch_single_step_tests.sh
tests/test_files/single_step_tests

# Blargg PPU test ROMs, fetched by tests/test_files/fetch_blargg_ppu.sh
tests/test_files/blargg_ppu

# Blargg cpu_interrupts_v2 ROMs, fetched by tests/test_files/fetch_cpu_interrupts.sh
tests/test_files/cpu_interrupts

# PPU address-space test ROMs, fetched by tests/test_files/fetch_ppu_address_space.sh
tests/test_files/ppu_address_space

# Blargg 2005 PPU test ROMs, fetched by tests/test_files/fetch_blargg_ppu_2005.sh
tests/test_files/blargg_ppu_2005

# Blargg sprite 0 hit ROMs, fetched by tests/test_files/fetch_sprite_hit.sh
tests/test_files/sprite_hit

# Blargg sprite overflow ROMs, fetched by tests/test_files/fetch_sprite_overflow.sh
tests/test_files/sprite_overflow

# Blargg read_joy3 controller ROM, fetched by tests/test_files/fetch_read_joy3.sh
tests/test_files/read_joy3

# Visual-check ROMs, fetched by tests/test_files/fetch_visual_roms.sh
tests/test_files/visual

# blargg's full_palette suite, fetched by tests/test_files/fetch_full_palette.sh
tests/test_files/full_palette

# blargg's apu_test suite, fetched by tests/test_files/fetch_apu_test.sh
tests/test_files/apu_test

# blargg's apu_reset suite, fetched by tests/test_files/fetch_apu_reset.sh
tests/test_files/apu_reset

# Blargg CPU reset / dummy-access ROMs, fetched by tests/test_files/fetch_cpu_behaviour.sh
tests/test_files/cpu_behaviour

# Blargg instr_test-v5 rom_singles, fetched by tests/test_files/fetch_instr_test.sh
tests/test_files/instr_test

# Blargg cpu_exec_space ROMs, fetched by tests/test_files/fetch_cpu_exec_space.sh
tests/test_files/cpu_exec_space

# Blargg MMC3 IRQ ROMs, fetched by tests/test_files/fetch_mmc3.sh
tests/test_files/mmc3

# Locally-supplied ROMs (yours, from your own cartridges). Never fetched, never
# committed - see tests/test_files/local/README.md. The README itself is kept.
tests/test_files/local/*
!tests/test_files/local/README.md

# ppu_read_buffer test ROM, fetched by tests/test_files/fetch_ppu_read_buffer.sh
tests/test_files/ppu_read_buffer
